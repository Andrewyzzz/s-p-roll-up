{
  "_schema": "disclosure-commitments-v1",
  "_description": "Per-attempt disclosure records. Each entry independently verifiable via OpenTimestamps + git.",
  "_note": "Populated from Task 3.3 (Week 6) through Task 9.4 (Week 23). See §8.4 of paper.",
  "_verification": "ots verify disclosure/attempts/<attempt>/content.txt.ots",
  "_vendors": {
    "D1_shared_sequencers": ["Astria", "Espresso", "Radius"],
    "D2_preconf_protocols": ["Primev (mev-commit)", "Chainbound (Bolt)"]
  },
  "_entry_schema": {
    "vendor":                "string — vendor name",
    "category":              "string — D1 or D2",
    "date":                  "string — YYYY-MM-DD UTC",
    "channel":               "string — twitter-dm / security-email / discord / forum",
    "git_commit_hash":       "string — commit hash immediately after outreach",
    "opentimestamps_proof":  "string — relative path to .ots file",
    "content_sha256":        "string — SHA-256 of content.txt",
    "response_date":         "string — YYYY-MM-DD or null",
    "response_summary":      "string — one-sentence summary or null"
  },
  "disclosure_attempts": [],
  "submission_aggregator_sha256": "TO_BE_COMPUTED_AT_TASK_10.5"
}
